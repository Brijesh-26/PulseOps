# Copy to .env for local development. Placeholders only: never commit real secrets.

PULSEOPS_ENVIRONMENT=local
PULSEOPS_LOG_LEVEL=INFO
PULSEOPS_LOG_JSON=true

# Postgres. The owner role runs migrations; the app role has restricted grants.
POSTGRES_PASSWORD=change-me-owner-password
PULSEOPS_APP_DB_PASSWORD=change-me-app-password
PULSEOPS_DATABASE_URL=postgresql+psycopg://pulseops_app:change-me-app-password@localhost:5433/pulseops
PULSEOPS_MIGRATION_DATABASE_URL=postgresql+psycopg://pulseops:change-me-owner-password@localhost:5433/pulseops

# Queue (local ElasticMQ is SQS-compatible; credentials are ignored by ElasticMQ).
PULSEOPS_QUEUE_BACKEND=sqs
PULSEOPS_SQS_ENDPOINT_URL=http://localhost:9324
PULSEOPS_AWS_REGION=me-central-1
AWS_ACCESS_KEY_ID=local-placeholder
AWS_SECRET_ACCESS_KEY=local-placeholder

# Auth: at least 32 random characters in prod (e.g. `openssl rand -hex 32`).
PULSEOPS_SESSION_SECRET=
PULSEOPS_CORS_ORIGINS=["http://localhost:5173"]

# Investigator: "mock" (default, offline, free) or "anthropic" (paid API calls).
PULSEOPS_INVESTIGATOR_PROVIDER=mock
PULSEOPS_ANTHROPIC_API_KEY=
PULSEOPS_ANTHROPIC_MODEL=claude-opus-5-5

# Demo: enables the admin-only scenario loader endpoint. Never enable in prod.
PULSEOPS_DEMO_MODE=true
